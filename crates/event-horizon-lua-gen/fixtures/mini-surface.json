    {
      "id": "hook:add_server_reload_listeners",
      "hash": "69dfd5d2318516e51bbbc79b03585533",
      "doc": "Register server data reload listeners after packs are selected. The\nhost gives registry access at registration, as\n`AddServerReloadListenersEvent.getRegistryAccess` does. Runs every data\nload on the owning server thread in Reloading: only registry facts,\nsettings and mod-list reads are available through this Host. World\nhandles, services and transactions panic naming the phase. Existing\ndata-load callbacks retain their DataLoadContext; no setup event is added.",
      "engine": {
        "target": "horizon_client::game::native_hooks::add_server_reload_listeners::Game<'_>::native_add_server_reload_listeners"
      },
      "counterparts": {
        "neoforge": [
          "AddServerReloadListenersEvent"
        ]
      },
      "version": 1,
      "side": "server",
      "contract": "listen",
      "host": "read",
      "arguments": [
        {
          "name": "listeners",
          "type": "&'a mut dyn ServerReloadListeners"
        }
      ],
      "refs": [
        "trait:ServerReloadListeners",
        "type:AddServerReloadListenersEvent"
      ],
      "fields": [
        {
          "id": "hook:add_server_reload_listeners.listeners",
          "hash": "f1271004cc405d055d8203433c68e5f6",
          "type": "&'a mut dyn ServerReloadListeners",
          "refs": [
            "hook:add_server_reload_listeners",
            "trait:ServerReloadListeners"
          ]
        }
      ]
    },
    {
      "id": "hook:affect_neighbors_after_removal",
      "hash": "f66e6bd3ebda3edfb5958ee98a249105",
      "doc": "`Block.affectNeighborsAfterRemoval` for a mod's block: an authoritative server removed the\nblock `state` from `pos` (`moved`: a piston pushed it) and has run its template class's own\nupdates. Push onto `updates` the neighbour updates it wants, in order: `OutputSignal`\n(`updateNeighbourForOutputSignal`), `Neighbours` (`updateNeighborsAt`) and\n`NeighboursExcept(direction)` (`updateNeighborsAtExceptFromFacing`); the level runs each\nat once, as the block's own override would. Answered from inside the level's write: it\nreads, and cannot write blocks or spawn entities.",
      "engine": {
        "target": "horizon_client::game::native_hooks::affect_neighbors_after_removal::GameLevel<'_>::native_affect_neighbors_after_removal"
      },
      "counterparts": {
        "neoforge": [
          "none (vanilla Block.affectNeighborsAfterRemoval; NeoForge adds no event or extension for it)"
        ]
      },
      "version": 1,
      "side": "server",
      "contract": "collect",
      "scope": {
        "kind": "block",
        "key": "state"
      },
      "arguments": [
        {
          "name": "dimension",
          "type": "LevelDimension"
        },
        {
          "name": "pos",
          "type": "BlockPos"
        },
        {
          "name": "state",
          "type": "BlockState"
        },
        {
          "name": "moved",
          "type": "bool"
        }
      ],
      "output": {
        "name": "updates",
        "type": "&'a mut Vec<NeighbourUpdate>"
      },
      "refs": [
        "type:AffectNeighborsAfterRemovalEvent",
        "type:BlockPos",
        "type:BlockState",
        "type:LevelDimension",
        "type:NeighbourUpdate"
      ],
      "fields": [
        {
          "id": "hook:affect_neighbors_after_removal.dimension",
          "hash": "afcf3f02486860a848a766ff3d0f18ad",
          "type": "LevelDimension",
          "refs": [
            "hook:affect_neighbors_after_removal",
            "type:LevelDimension"
          ]
        },
        {
          "id": "hook:affect_neighbors_after_removal.pos",
          "hash": "bf8d45612bba403e52969c08f589af5a",
          "type": "BlockPos",
          "refs": [
            "hook:affect_neighbors_after_removal",
            "type:BlockPos"
          ]
        },
        {
          "id": "hook:affect_neighbors_after_removal.state",
          "hash": "ca956149abd5df575f815884348dab57",
