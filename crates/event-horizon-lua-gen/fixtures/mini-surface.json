            "type:BlockState"
          ]
        },
        {
          "id": "hook:affect_neighbors_after_removal.moved",
          "hash": "8cc66f1777ae616c750249db3add89c6",
          "type": "bool",
          "refs": [
            "hook:affect_neighbors_after_removal"
          ]
        },
        {
          "id": "hook:affect_neighbors_after_removal.updates",
