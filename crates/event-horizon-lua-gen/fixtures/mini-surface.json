    {
      "id": "hook:attack_entity",
      "hash": "17bd48c105d6bfb6937892ef6a46a655",
      "doc": "A player attacks the entity `entity` (`Entity.getId`) of type `kind`\n(`minecraft:item_frame`, `minecraft:cow`, `minecraft:player`) standing\nat `pos`: `ServerGamePacketListenerImpl.handleInteract`'s attack, once\nin reach, where `Player.attack` starts. The swing has not begun, so the\nattacking player's attack strength is still the charge the blow uses\n(vanilla reads it at the start of `Player.attack`; the swing resets it\nafterwards). Set `canceled` and the blow does nothing (no damage, no\nknockback, the frame keeps its item). Server-side, for every player of\nthe world (`host.players().acting_player()` says who).",
      "engine": {
        "target": "horizon_client::game::native_hooks::base::Game<'_>::native_attack_entity"
      },
      "counterparts": {
        "neoforge": [
          "AttackEntityEvent"
        ]
      },
      "version": 1,
      "side": "server",
      "contract": "cancel",
      "arguments": [
